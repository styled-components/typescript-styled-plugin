{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "commonjs",
    "target": "ES2024",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src", "test/unit", "test/performance", "tsdown.config.ts"],
  "exclude": ["lib", "node_modules", "test/e2e"]
}
