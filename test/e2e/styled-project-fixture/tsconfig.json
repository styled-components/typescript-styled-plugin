{
  "compilerOptions": {
    "allowJs": true,
    "jsx": "preserve",
    "noEmit": true,
    "target": "ES2021",
    "module": "commonjs",
    "strict": true,
    "plugins": [
      {
        "name": "@styled/typescript-styled-plugin",
        "tags": [
          "styled",
          "css",
          "extend",
          "injectGlobal",
          "createGlobalStyle",
          "globalCss",
          "keyframes"
        ]
      }
    ]
  }
}
